{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "piga-pocket-interface-mesh-preview",
  "main": "./src/index.js",
  "compatibility_date": "2026-08-28",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "APP_ENV": "showroom",
    "SOURCE_COMMIT": "showroom-proxy-v1",
    "SHOWROOM_ORIGIN": "https://piga-pocket-showroom.piga-pocket-9123.chatgpt.site"
  }
}
